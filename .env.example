# Copy this file to .env for local development.
# Values here are placeholders or non-sensitive local defaults. Never commit a real .env file.

APP_ENV=development

POSTGRES_DB=vitaminbot
POSTGRES_USER=vitaminbot
POSTGRES_PASSWORD=replace-with-local-development-password
POSTGRES_PORT=5432

DATABASE_URL=postgresql://vitaminbot:replace-with-local-development-password@localhost:5432/vitaminbot
# Used by docker-compose services; "postgres" is the Compose service hostname.
DATABASE_URL_DOCKER=postgresql://vitaminbot:replace-with-local-development-password@postgres:5432/vitaminbot
# Create a bot token outside the repository and keep the real value only in local/deployment secrets.
TELEGRAM_BOT_TOKEN=replace-with-local-telegram-bot-token

# Routine bucket clock times are product defaults, not biological timing claims.
REMINDER_MORNING_TIME=08:00
REMINDER_DAY_TIME=13:00
REMINDER_EVENING_TIME=19:00
REMINDER_LATER_MINUTES=30
REMINDER_POLL_SECONDS=30
