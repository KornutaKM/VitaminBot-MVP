# Copy this file to .env for local development.
# Values here are placeholders or non-sensitive local defaults. Never commit a real .env file.

APP_ENV=development

POSTGRES_DB=vitaminbot
POSTGRES_USER=vitaminbot
POSTGRES_PASSWORD=replace-with-local-development-password
POSTGRES_PORT=5432

REDIS_PORT=6379

DATABASE_URL=postgresql://vitaminbot:replace-with-local-development-password@localhost:5432/vitaminbot
REDIS_URL=redis://localhost:6379/0

# Create a bot token outside the repository and keep the real value only in local/deployment secrets.
TELEGRAM_BOT_TOKEN=replace-with-local-telegram-bot-token
